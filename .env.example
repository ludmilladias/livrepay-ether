# Copie para .env e preencha. NUNCA commite o .env real.
# ---------------------------------------------------------------------------
# Banco (Postgres puro — sem BaaS)
# ---------------------------------------------------------------------------
POSTGRES_DB=livrepay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # senha do superusuário (só migrations/admin)
POSTGRES_PORT=5433

# Role usada pela API. NÃO é dona das tabelas — é isso que faz a RLS valer.
APP_DB_USER=livrepay_app
APP_DB_PASSWORD=              # senha forte, diferente da acima

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8081
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=                   # mínimo 32 caracteres
ALLOWED_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# Provedor bancário (Ether Global Assets) — segredos ficam SÓ no servidor
# ---------------------------------------------------------------------------
ETHER_BASE_URL=https://api.etherglobalassets.com.br
ETHER_CLIENT_ID=
ETHER_CLIENT_SECRET=
ETHER_WEBHOOK_SECRET=         # gere um valor aleatório longo; URL do webhook para a Ether: /webhooks/ether/<este-valor>

# ---------------------------------------------------------------------------
# Frontend (Vite) — tudo aqui é PÚBLICO, vai para o bundle do navegador.
# Jamais coloque segredo em variável VITE_*.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8081
